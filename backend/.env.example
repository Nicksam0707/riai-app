# Copy this to backend/.env and fill in the values
# OpenAI credentials
OPENAI_API_KEY=

# Optional: pre-uploaded IRIB guide attachment id used for Escritura analysis
# Run: python upload_guia_irib.py and paste the printed file_id here
GUIA_IRIB_FILE_ID=

# Model selection (overrides)
# Recommended minimal-cost model for both flows
MODEL_CERTIDAO=gpt-5-mini
MODEL_ESCRITURA=gpt-5-mini

# Debug toggle (enables detailed error traces in 502 responses)
DEBUG=false
