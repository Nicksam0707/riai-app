 def extrair_texto_pdf(file_bytes):
     texto = ""
     try:
         with pdfplumber.open(file_bytes) as pdf:
             for page in pdf.pages:
                 texto += page.extract_text() or ""
     except Exception:
         pass
 
     if not texto.strip():
         imagens = convert_from_bytes(file_bytes)
         for img in imagens:
             texto += pytesseract.image_to_string(img)
     return texto
 
